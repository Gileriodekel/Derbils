{
  "name": "derbil-dynasty",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "build:standalone": "node scripts/standalone.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sim.json",
    "report": "node scripts/report.mjs",
    "gallery:svg": "node scripts/gallery-svg.mjs",
    "bench:appearance": "node scripts/bench-appearance.mjs",
    "bench:sim": "node scripts/bench-sim.mjs",
    "bench:long-play": "node --expose-gc scripts/bench-long-play.mjs",
    "tuning:doc": "node scripts/tuning-doc.mjs",
    "balance": "node scripts/balance.mjs",
    "soak": "node scripts/soak.mjs",
    "test:smoke": "npm run build && playwright test",
    "test:dynasty": "vitest run tests/dynasty-*.test.ts tests/offline-boundaries.test.ts",
    "test:breeding": "vitest run tests/breeding-balance.test.ts",
    "balance:breeding": "node scripts/breeding-study.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@xmldom/xmldom": "0.9.12",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}
